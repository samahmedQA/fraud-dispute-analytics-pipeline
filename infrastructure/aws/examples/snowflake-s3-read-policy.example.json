{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFraudDisputeBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::<S3_BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadFraudDisputeObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<S3_BUCKET_NAME>/raw/*"
    }
  ]
}
